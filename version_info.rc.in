VS_VERSION_INFO VERSIONINFO
    FILEVERSION    @VERSION_INFO@
    PRODUCTVERSION @VERSION_INFO@
    FILEFLAGSMASK 0x3fL
    FILEFLAGS 0x0L
    FILEOS 0x40004L
    FILETYPE 0x1L
    FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "University Project"
            VALUE "FileDescription", "@PROJECT_DESCRIPTION@"
            VALUE "FileVersion", "@VERSION_INFO@"
            VALUE "InternalName", "ip_filter"
            VALUE "ProductName", "IP Filter Laboratory"
            VALUE "ProductVersion", "@VERSION_INFO@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END